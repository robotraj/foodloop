# Copy to .env and fill in. Without a key FoodLoop runs in offline (rule-based) mode.
ANTHROPIC_API_KEY=
# FOODLOOP_MODEL=claude-opus-5
# FOODLOOP_OFFLINE=1

# Protect the agent/admin endpoints (open admin.html?token=... to use them)
# ADMIN_TOKEN=

# Pricing
BASE_PRICE_PER_PORTION=2.50

# Fair-share limits
MAX_PORTIONS_PER_LISTING=2
MAX_RESERVATIONS_PER_DAY=2

# Router: large batches go to a food bank, large inedible volumes to biogas,
# and food with less than this many minutes left to collect is not listed
DONATE_MIN_PORTIONS=20
BIOGAS_MIN_PORTIONS=20
MIN_SELL_MINUTES=20

# Impact estimates shown in the console (rough figures, tune to your own data)
# KG_PER_PORTION=0.4
# CO2E_PER_KG_RESCUED=2.5
# COMPOST_YIELD=0.3
# BIOGAS_M3_PER_KG=0.12

# Google Maps (optional). Without keys the finder uses OpenStreetMap and the app shows no map,
# but cards still link to Google Maps.
# Server key with "Places API (New)" enabled. Billed per request: a full-city run is a few hundred.
GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACES_TYPES=restaurant,cafe,meal_takeaway
# Browser key with "Maps JavaScript API" enabled. It is sent to every visitor, so restrict it
# by HTTP referrer (e.g. http://localhost:3000/*) in Google Cloud Console.
GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Outreach agent: real email through Resend (https://resend.com). Drafts are only sent after
# you approve them in the agent console. See README "Outreach agent".
RESEND_API_KEY=
# OUTREACH_FROM_EMAIL=FoodLoop <hello@yourdomain.nl>
# OUTREACH_REPLY_TO=you@yourdomain.nl
# Organisation name and postal address, shown in every email's footer
# OUTREACH_SENDER_INFO=FoodLoop, Damrak 1, 1012 LG Amsterdam
# OUTREACH_DAILY_CAP=20
# Turns on POST /api/inbound/email?secret=... for replies from an inbound-email service
# INBOUND_EMAIL_SECRET=

DEFAULT_RADIUS_KM=2
PORT=3000
