# Copy to .env and fill in. Without a key FoodLoop runs in offline (rule-based) mode.
ANTHROPIC_API_KEY=
# FOODLOOP_MODEL=claude-opus-5
# FOODLOOP_OFFLINE=1

# Protect the agent/admin endpoints (open admin.html?token=... to use them)
# ADMIN_TOKEN=

# Fair-share limits
MAX_PORTIONS_PER_LISTING=2
MAX_RESERVATIONS_PER_DAY=2

# Donation in EUR: packaging per portion + flat app fee
PACKAGING_PER_PORTION=0.75
PLATFORM_FEE=0.50

DEFAULT_RADIUS_KM=2
PORT=3000
